APP_NAME="Obras Públicas Ramallo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# RNF-LOC-001: español de Argentina, fechas DD/MM/AAAA, metros.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
# Fechas operativas en hora local; los timestamps técnicos van en UTC.
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# El hash de contraseñas es Argon2id (RNF-SEC-002), no bcrypt.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de datos — MariaDB 10.11.18, único motor soportado (D1, compuerta G1).
# No es `mysql`: Laravel 11+ trae un grammar dedicado para MariaDB y el DDL
# geométrico que emite es distinto (ver P3 en docs/MATRIZ-ESPACIAL.md).
# ---------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=obras
DB_USERNAME=obras
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sesión y transporte (RNF-SEC-001)
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción va en true: la cookie sólo viaja por HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Cola y caché con driver de base de datos; Redis es opcional y no se usa.
# La invalidación de caché es por clave de versión, no por etiquetas: los
# drivers `database` y `file` no soportan tags (sección 2 del plan).
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="obraspublicas@ramallo.gob.ar"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Límite de tasa del login (RNF-SEC-004). Todo intento fallido se audita.
# ---------------------------------------------------------------------------
LOGIN_THROTTLE_PER_MINUTE=5
LOGIN_THROTTLE_PER_HOUR=20

# ---------------------------------------------------------------------------
# Presupuesto de propagación (RF-BO-010). El caché es red de seguridad, no
# mecanismo de propagación: la invalidación es sincrónica al commit.
# ---------------------------------------------------------------------------
PUBLIC_CACHE_TTL_SECONDS=30
PUBLIC_POLL_INTERVAL_SECONDS=30
LIVE_POLL_INTERVAL_SECONDS=15
LIVE_TOUR_INTERVAL_SECONDS=12

# ---------------------------------------------------------------------------
# Geocodificación — categoría (b) de la política de secretos: no es secreto,
# es cumplimiento. La instancia pública de Nominatim exige identificación,
# limita a 1 req/s y prohíbe autocompletado (spec T2).
# ---------------------------------------------------------------------------
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="ObrasPublicasRamallo/1.0 (contacto institucional)"
NOMINATIM_CONTACT_EMAIL=
NOMINATIM_RATE_LIMIT_PER_SECOND=1
NOMINATIM_CACHE_TTL_SECONDS=86400
# Sesgo de búsqueda al partido de Ramallo. Valores definitivos en G3: el
# recorte del IGN es la fuente, no una estimación.
NOMINATIM_VIEWBOX=

# ---------------------------------------------------------------------------
# Trazado asistido — categoría (a): secreto de backend, nunca sale del
# servidor (RF-GEO-016). El fallback manual hace que agotar la cuota degrade
# el servicio sin romperlo (RF-GEO-008).
# ---------------------------------------------------------------------------
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=
ORS_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Teselas — categoría (c): puede ser público, con las seis condiciones de
# `docs/ARQUITECTURA.md`. Si el proveedor permite proxy seguro, se usa proxy
# desde el backend y este token no se expone al cliente.
# ---------------------------------------------------------------------------
TILES_PROVIDER=
TILES_URL_TEMPLATE=
TILES_ATTRIBUTION=
TILES_PUBLIC_TOKEN=
TILES_MIN_ZOOM=11
TILES_MAX_ZOOM=18

# ---------------------------------------------------------------------------
# Backups (RNF-SEC-008, RNF-RES-001). Dos credenciales separadas:
# el VPS sólo puede ESCRIBIR. La retención de 30 días la aplica el lifecycle
# del bucket, así que la credencial de escritura no lleva DeleteObject, y la
# credencial de lectura vive fuera del VPS, en poder de la Municipalidad.
# ---------------------------------------------------------------------------
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
# Sólo PutObject. Sin GetObject, sin DeleteObject, sin ListBucket.
BACKUP_S3_WRITE_KEY_ID=
BACKUP_S3_WRITE_SECRET=
# Clave PÚBLICA de `age`: el servidor cifra pero no puede descifrar sus
# propios backups. La clave privada la custodia la Municipalidad, nunca acá.
BACKUP_AGE_RECIPIENT=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
