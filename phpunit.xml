<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!-- Argon2id al mínimo en tests: el costo alto es una defensa en
             producción, no algo que haya que pagar en cada aserción. -->
        <env name="ARGON_MEMORY" value="8192"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="ARGON_THREADS" value="1"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- La suite corre contra MariaDB, no contra SQLite en memoria. Buena
             parte de lo que hay que verificar es específica del motor: DDL
             geométrico, índices SPATIAL, disparadores de inmutabilidad y el
             comportamiento de ST_*. Un test que pasa en SQLite no dice nada
             sobre producción. -->
        <env name="DB_CONNECTION" value="mariadb"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3308"/>
        <env name="DB_DATABASE" value="obras_test"/>
        <env name="DB_USERNAME" value="obras"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
